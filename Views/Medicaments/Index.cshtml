@model IEnumerable<Hospitel_Project.Models.Medicament>

@{
    ViewData["Title"] = "Medicament List";
}

<div class="container mt-4">
    <h1 class="text-primary text-center">Medicament List</h1>

    <div class="d-flex justify-content-between my-3">
        <a asp-action="Create" class="btn btn-outline-success">
            <i class="bi bi-plus-lg"></i> Create New
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Name)</th>
                        <th>@Html.DisplayNameFor(model => model.TimeOfdosage)</th>
                        <th>@Html.DisplayNameFor(model => model.price)</th>
                        <th>@Html.DisplayNameFor(model => model.stock)</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="align-middle">
                            <td>@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.TimeOfdosage)</td>
                            <td>@Html.DisplayFor(modelItem => item.price)</td>
                            <td>@Html.DisplayFor(modelItem => item.stock)</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.MedicamentId" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a asp-action="Details" asp-route-id="@item.MedicamentId" class="btn btn-sm btn-outline-info ">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.MedicamentId" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
