@model Hospitel_Project.Models.Doctor

@{
    ViewData["Title"] = "Delete Doctor";
}

<div class="container mt-5">
    <div class="card shadow-lg border-danger">
        <div class="card-header bg-danger text-white text-center">
            <h2>Delete Doctor</h2>
        </div>
        <div class="card-body">
            <h4 class="text-center text-danger fw-bold">Are you sure you want to delete this doctor?</h4>
            <hr />

            <dl class="row">
                <dt class="col-sm-4 text-end fw-bold">Doctor ID:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.DoctorId)</dd>

                <dt class="col-sm-4 text-end fw-bold">Name:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

                <dt class="col-sm-4 text-end fw-bold">Specialty:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Specialty)</dd>
            </dl>

            <div class="text-center mt-4">
              
                 <a asp-controller="Doctor" asp-action="DeleteConfirmed" asp-route-id="@Model.DoctorId" class="btn  btn-danger"> Confirma Delete </a> @*this is solution *@ 

              
                <form asp-action="DeleteConfirmed" method="post" class="d-inline"> 
                   <input type="hidden" asp-for="DoctorId" /> 
                 </form>

                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </div>
</div>
