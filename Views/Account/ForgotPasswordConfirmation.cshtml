
@{
    ViewData["Title"] = "ForgotPasswordConfirmation";
}

<h1>ForgotPasswordConfirmation</h1>

<div class="container text-center mt-5">
    <h2>Password Reset Email Sent</h2>
    <p>
        If an account exists with the email you entered, a password reset link has been sent to your email.
        Please check your inbox and follow the instructions to reset your password.
    </p>
    <a asp-action="Login" class="btn btn-primary">Back to Login</a>
</div>