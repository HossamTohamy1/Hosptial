@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "ForgotPassword";
}

<h1>ForgotPassword</h1>

<p>Enter your email to reset your password.</p>

<form asp-action="ForgotPassword" method="post">
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" placeholder="Enter your email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <button id="forget_password" type="submit" class="btn btn-primary w-100">
        <span id="btn-text">Send</span>
        <span id="btn-loader" class="spinner-border spinner-border-sm d-none"></span>
    </button>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.querySelector("form"); // تحديد الفورم
            const button = document.getElementById("forget_password");
            const btnText = document.getElementById("btn-text");
            const btnLoader = document.getElementById("btn-loader");

            form.addEventListener("submit", function () {
                button.disabled = true; // تعطيل الزر لمنع النقر المتكرر
                btnText.classList.add("d-none"); // إخفاء النص
                btnLoader.classList.remove("d-none"); // إظهار التحميل
            });
        });
    </script>

 
</form>
