@model Hospitel_Project.Models.Prescription

@{
    ViewData["Title"] = "Delete";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-danger text-white">
            <h4 class="text-center">Are you sure you want to delete this prescription?</h4>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4 font-weight-bold">Date Prescribed:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.DatePrescribed)</dd>

                <dt class="col-sm-4 font-weight-bold">Quantity:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Quantity)</dd>

                <dt class="col-sm-4 font-weight-bold">Description:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.description)</dd>

                <dt class="col-sm-4 font-weight-bold">Patient Name:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Patient.FirstName) @Html.DisplayFor(model => model.Patient.LastName)</dd>

                <dt class="col-sm-4 font-weight-bold">Medicament:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Medicament.Name)</dd>
            </dl>
        </div>

        <div class="card-footer text-center">
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="PrescriptionId" />
                <button type="submit" class="btn btn-danger">Confirm Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
